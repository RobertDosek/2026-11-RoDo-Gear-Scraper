# Copy this file to .env (git-ignored) and fill it in, then restart the app.

# ---- Telegram: direct alerts on your phone ----
# 1. In Telegram, open @BotFather, send /newbot and pick a name. It gives you the token below.
# 2. Open your new bot and send it any message (a bot can't write to you first).
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser; "chat":{"id": ...} is your chat id.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789

# ---- hudebnibazar.cz login: needed to send answers to sellers ----
# Answering an ad needs a logged-in account (an account with a password, not Google/Seznam sign-in).
# Check it with: python -m scrapers.hb_reply probe https://hudebnibazar.cz/<some-ad>/ID123456/
HUDEBNIBAZAR_EMAIL=you@example.com
HUDEBNIBAZAR_PASSWORD=your-password
